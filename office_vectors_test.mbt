// Vectors migrated from office.mbt's zip package, which exercised these shapes
// against its own hand-rolled decoder. They pin behaviors a reference decoder
// (zlib, and the miniz stream documented in office's test) accepts.

///|
test "dynamic block with an all-zero distance tree decodes" {
  // miniz shape: HDIST=1, distance tree all zero, 8 literals of one bit.
  let stream : Bytes = [
    0x05, 0xC0, 0x21, 0x09, 0x00, 0x00, 0x00, 0x00, 0x20, 0xFF, 0xAF, 0x16, 0x80,
  ]
  assert_eq(inflate_all(stream).length(), 8)
}

///|
test "referencing an all-zero distance tree is refused" {
  // Literal 'A', then length symbol 257, obliging the decoder to read a
  // distance code the declared tree does not contain.
  let stream : Bytes = [
    0x0D, 0xC0, 0xB1, 0x09, 0x00, 0x00, 0x00, 0x80, 0xA0, 0xDB, 0xFC, 0xFF, 0xA9,
    0xC2, 0x00,
  ]
  try ignore(inflate_all(stream)) catch {
    InflateError(kind, message) => {
      assert_true(kind == Corrupt)
      assert_eq(message, "corrupt: bad Huffman code")
    }
  } noraise {
    _ => fail("referencing an all-zero distance tree must be refused")
  }
}

///|
test "office-shaped malformed headers raise stable diagnostics" {
  // Empty dynamic table: all code-length code lengths zero.
  try ignore(inflate_all(([0x05, 0x00, 0x00, 0x00] : Bytes))) catch {
    InflateError(kind, message) => {
      assert_true(kind == Corrupt)
      assert_eq(message, "corrupt: bad Huffman code")
    }
  } noraise {
    _ => fail("empty dynamic table must be refused")
  }
  // Reserved block type.
  try ignore(inflate_all(([0x07] : Bytes))) catch {
    InflateError(kind, message) => {
      assert_true(kind == Corrupt)
      assert_eq(message, "corrupt: reserved block type")
    }
  } noraise {
    _ => fail("reserved block type must be refused")
  }
  // Stored block with an invalid LEN/NLEN pair.
  try
    ignore(inflate_all(([0x01, 0x01, 0x00, 0x00, 0x00, 0x41] : Bytes)))
  catch {
    InflateError(kind, message) => {
      assert_true(kind == Corrupt)
      assert_eq(message, "stored block length mismatch")
    }
  } noraise {
    _ => fail("invalid stored length must be refused")
  }
}

///|
test "office dynamic huffman vector decodes in full" {
  let stream : Bytes = [
    0xED, 0xCA, 0xC9, 0x01, 0x82, 0x40, 0x10, 0x00, 0xB0, 0x56, 0xA6, 0xA8, 0x6D,
    0xC0, 0x03, 0xF0, 0x40, 0x06, 0x56, 0x17, 0xD4, 0xEA, 0xB1, 0x04, 0x0B, 0xC8,
    0x3B, 0x29, 0x97, 0x2E, 0x96, 0x76, 0x3D, 0xDD, 0xE3, 0x58, 0x73, 0x9B, 0xA2,
    0xCF, 0x77, 0xDC, 0xDA, 0x63, 0x7E, 0x46, 0xAE, 0x5D, 0x8D, 0xD7, 0x8F, 0xC7,
    0xC3, 0xF7, 0x13, 0xE7, 0x1C, 0x8A, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA,
    0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA,
    0xAA, 0xAA, 0xAA, 0xAA, 0xFA, 0x7F, 0xDD, 0x01,
  ]
  let out = inflate_all(stream)
  let phrase = b"The quick brown fox jumps over the lazy dog"
  let expected : Array[Byte] = []
  for _ in 0..<200 {
    for byte in phrase {
      expected.push(byte)
    }
  }
  assert_eq(out.length(), 8600)
  assert_eq(out, Bytes::from_array(expected))
}

///|
/// A stream truncated mid-symbol (the valid 86-byte vector above with one
/// tail byte removed) must raise Truncated, never silently return partial
/// output. The hand-rolled decoder this vector was migrated from also
/// rejected the shape (OutOfBounds), so this pins the shared strictness.
test "a truncated dynamic-block stream is rejected" {
  let truncated : Bytes = [
    0xED, 0xCA, 0xC9, 0x01, 0x82, 0x40, 0x10, 0x00, 0xB0, 0x56, 0xA6, 0xA8, 0x6D,
    0xC0, 0x03, 0xF0, 0x40, 0x06, 0x56, 0x17, 0xD4, 0xEA, 0xB1, 0x04, 0x0B, 0xC8,
    0x3B, 0x29, 0x97, 0x2E, 0x96, 0x76, 0x3D, 0xDD, 0xE3, 0x58, 0x73, 0x9B, 0xA2,
    0xCF, 0x77, 0xDC, 0xDA, 0x63, 0x7E, 0x46, 0xAE, 0x5D, 0x8D, 0xD7, 0x8F, 0xC7,
    0xC3, 0xF7, 0x13, 0xE7, 0x1C, 0x8A, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA,
    0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA,
    0xAA, 0xAA, 0xAA, 0xFA, 0x7F, 0xDD, 0x01,
  ]
  try ignore(inflate_all(truncated)) catch {
    InflateError(kind, _) => assert_true(kind == Truncated)
  } noraise {
    _ => fail("the truncated stream must be rejected")
  }
}
